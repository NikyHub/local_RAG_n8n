{
  "name": "RAG - 审核处理流",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "review",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000001",
      "name": "Webhook Review",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Validate review input\nconst body = $input.first().json;\nconst validActions = ['approved', 'rejected'];\n\nif (!body.reviewer_id || !body.report_id || !body.action) {\n  throw new Error('reviewer_id, report_id, and action are required');\n}\nif (!validActions.includes(body.action)) {\n  throw new Error('action must be approved or rejected');\n}\n\nreturn {\n  reviewer_id: body.reviewer_id,\n  report_id: body.report_id,\n  action: body.action,\n  review_comment: body.review_comment || '',\n  reviewed_at: new Date().toISOString(),\n};"
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000002",
      "name": "Validate Review",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE experience_reports SET status = $1, reviewer_id = $2, review_comment = $3, reviewed_at = NOW() WHERE id = $4",
        "additionalFields": {
          "parameters": "={{ [$json.action, $json.reviewer_id, $json.review_comment, $json.report_id].join('|||SPLIT|||') }}"
        }
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000003",
      "name": "Update Report Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [750, 300],
      "credentials": {
        "postgres": "factory-rag-postgres"
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "output": 0
            }
          ]
        },
        "options": {
          "fallbackOutput": 1
        }
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000004",
      "name": "Route by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "jsCode": "// Fetch the full report to forward to experience-ingest workflow\nconst reviewData = $('Validate Review').first().json;\n\n// Call experience-ingest workflow webhook\nreturn {\n  report_id: reviewData.report_id,\n  reviewer_id: reviewData.reviewer_id,\n  trigger_action: 'ingest_approved_experience',\n};"
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000005",
      "name": "Prepare Ingest Trigger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_WEBHOOK_URL || 'http://localhost:5678/' }}webhook/experience-ingest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000006",
      "name": "Trigger Experience Ingest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1500, 200]
    },
    {
      "parameters": {
        "jsCode": "// Build rejection notification\nconst reviewData = $('Validate Review').first().json;\n\nreturn {\n  msgtype: 'text',\n  text: {\n    content: `【经验报告审核结果】\\n报告ID：${reviewData.report_id}\\n审核结果：驳回\\n驳回原因：${reviewData.review_comment || '未说明'}\\n审核时间：${reviewData.reviewed_at}\\n\\n请修改后重新提交。`\n  },\n  report_id: reviewData.report_id,\n  action: 'rejected',\n};"
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000007",
      "name": "Build Reject Notice",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1250, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NOTIFICATION_WEBHOOK_URL || 'http://localhost:5678/webhook/notification-fallback' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "continueOnFail": true
        }
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000008",
      "name": "Notify Rejection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1500, 400]
    },
    {
      "parameters": {
        "jsCode": "const reviewData = $('Validate Review').first().json;\nconst ingestResult = $input.first().json;\n\nreturn {\n  status: 'ok',\n  action: reviewData.action,\n  report_id: reviewData.report_id,\n  message: reviewData.action === 'approved'\n    ? '审核通过，经验已入库'\n    : '已驳回',\n  ingest_result: reviewData.action === 'approved' ? ingestResult : null,\n};"
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000009",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1750, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($('Build Response').first().json) }}"
      },
      "id": "d1e2f3g4-0001-4000-8000-000000000010",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [2000, 300]
    }
  ],
  "connections": {
    "Webhook Review": {
      "main": [[{"node": "Validate Review", "type": "main", "index": 0}]]
    },
    "Validate Review": {
      "main": [[{"node": "Update Report Status", "type": "main", "index": 0}]]
    },
    "Update Report Status": {
      "main": [[{"node": "Route by Action", "type": "main", "index": 0}]]
    },
    "Route by Action": {
      "main": [
        [{"node": "Prepare Ingest Trigger", "type": "main", "index": 0}],
        [{"node": "Build Reject Notice", "type": "main", "index": 0}]
      ]
    },
    "Prepare Ingest Trigger": {
      "main": [[{"node": "Trigger Experience Ingest", "type": "main", "index": 0}]]
    },
    "Trigger Experience Ingest": {
      "main": [[{"node": "Build Response", "type": "main", "index": 0}]]
    },
    "Build Reject Notice": {
      "main": [[{"node": "Notify Rejection", "type": "main", "index": 0}]]
    },
    "Notify Rejection": {
      "main": [[{"node": "Build Response", "type": "main", "index": 0}]]
    },
    "Build Response": {
      "main": [[{"node": "Respond", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false
  }
}
