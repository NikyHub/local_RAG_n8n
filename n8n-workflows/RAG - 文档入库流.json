        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "function uuid4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0;\n    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n  });\n}\n\nconst embedResult = $input.first().json;\nconst embeddings = embedResult.embeddings || [];\nconst chunkItems = $('Prepare Chunk Items').all();\n\nconst points = chunkItems.map((item, i) => ({\n  id: uuid4(),\n  vector: embeddings[i] || [],\n  payload: {\n    doc_type: item.json.doc_type,\n    machine_type: item.json.machine_type,\n    category: item.json.category,\n    chunk_text: item.json.text,\n    chunk_index: item.json.chunk_index,\n    source_title: item.json.title,\n    source_file: item.json.source_file || '',\n    uploaded_by: item.json.uploaded_by,\n    ingest_id: item.json.ingest_id,\n    created_at: new Date().toISOString(),\n  }\n}));\n\nreturn {\n  points,\n  point_count: points.length,\n  ingest_id: chunkItems[0]?.json?.ingest_id,\n  title: chunkItems[0]?.json?.title,\n  doc_type: chunkItems[0]?.json?.doc_type,\n  category: chunkItems[0]?.json?.category,\n  machine_type: chunkItems[0]?.json?.machine_type,\n  uploaded_by: chunkItems[0]?.json?.uploaded_by,\n  chunk_details: chunkItems.map(c => ({\n    chunk_index: c.json.chunk_index,\n    content: c.json.text,\n  })),\n};"
      },
