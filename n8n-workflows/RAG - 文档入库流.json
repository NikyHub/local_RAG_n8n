    {
      "parameters": {
        "jsCode": "const docId = $input.first().json.id || $input.first().json.rows?.[0]?.id;\nconst assemblerData = $('Prepare PG Insert').first().json;\nconst chunks = assemblerData.chunk_details || [];\n\nreturn chunks.map((chunk, i) => ({\n  document_id: docId,\n  chunk_index: chunk.chunk_index,\n  content: chunk.content,\n  qdrant_point_id: assemblerData.ingest_id + '_' + chunk.chunk_index,\n  sql: `INSERT INTO knowledge_chunks (document_id, chunk_index, content, qdrant_point_id) VALUES ('${docId || ''}', ${chunk.chunk_index}, '${(chunk.content || '').replace(/'/g, \"''\")}', '${assemblerData.ingest_id}_${chunk.chunk_index}')`,\n}));"
      },
