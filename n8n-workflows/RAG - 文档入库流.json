    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst binary = $input.first().binary;\nconst fileKey = Object.keys(binary || {})[0];\n\nreturn [{\n  json: {\n    title: body.title || 'Untitled Document',\n    doc_type: body.doc_type || 'manual',\n    machine_type: body.machine_type || '',\n    category: body.category || '',\n    uploaded_by: body.uploaded_by || '',\n    original_filename: body.original_filename || '',\n    file_path: body.file_path || '',\n    mime_type: body.mime_type || '',\n    file_type: (body.mime_type || '').includes('pdf') ? 'pdf' : ((body.mime_type || '').includes('image') ? 'image' : 'unknown'),\n    ingest_id: Date.now().toString(36) + Math.random().toString(36).slice(2, 8),\n  },\n  binary: fileKey ? {\n    file: binary[fileKey]\n  } : {}\n}];"
      },
