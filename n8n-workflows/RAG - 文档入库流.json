    {
      "parameters": {
        "jsCode": "const meta = $('Assemble Qdrant Points').first().json;\n\n// 直接拼 SQL，不用 $1 $2 参数化\nconst sql = `INSERT INTO documents (title, doc_type, file_path, uploaded_by, chunk_count, status, machine_type, category)\nVALUES ('${(meta.title || '').replace(/'/g, \"''\")}', '${(meta.doc_type || '').replace(/'/g, \"''\")}', '${(meta.file_path || '').replace(/'/g, \"''\")}', '${(meta.uploaded_by || '').replace(/'/g, \"''\")}', ${meta.point_count || 0}, 'ready', '${(meta.machine_type || '').replace(/'/g, \"''\")}', '${(meta.category || '').replace(/'/g, \"''\")}') RETURNING id`;\n\nreturn {\n  sql,\n  ...meta,\n};"
      },
