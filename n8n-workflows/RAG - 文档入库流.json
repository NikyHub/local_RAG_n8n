    {
      "parameters": {
        "jsCode": "// Split chunk response into individual items for embedding\nconst result = $input.first().json;\nconst chunks = result.chunks || [];\n\n// Return each chunk as a separate output item\nreturn chunks.map(chunk => ({\n  chunk_index: chunk.chunk_index,\n  text: chunk.text,\n  char_count: chunk.char_count,\n  source_file: $('Merge Parse Result').first().json.source_file || '',\n  ingest_id: $('Merge Parse Result').first().json.ingest_id,\n  title: $('Merge Parse Result').first().json.title,\n  doc_type: $('Merge Parse Result').first().json.doc_type,\n  machine_type: $('Merge Parse Result').first().json.machine_type,\n  category: $('Merge Parse Result').first().json.category,\n  uploaded_by: $('Merge Parse Result').first().json.uploaded_by,\n  page_count: $('Merge Parse Result').first().json.page_count,\n}));"
      },
      "id": "f3e58e3c-3889-4fc7-b036-5eb67c458787",
      "name": "Prepare Chunk Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        816,
        -32
      ]
    },
    {
      "parameters": {
        "jsCode": "// Collect all chunk texts for batch embedding\nconst items = $input.all();\nconst chunkTexts = items.map(item => item.json.text);\n\n// Batch embed all chunks at once\nreturn {\n  texts: chunkTexts,\n  item_count: items.length,\n  // Preserve original items in the workflow\n  ingest_id: items[0]?.json?.ingest_id,\n};"
      },
      "id": "c929757e-c5f6-4764-b31a-52bc6a072b4d",
      "name": "Build Embed Batch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1072,
        -32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ocr-container:8002/api/embed",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ texts: $json.texts }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "5986b29f-8b2e-44bc-9e10-a38733ca0400",
      "name": "Batch Embed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
