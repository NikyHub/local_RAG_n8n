    {
      "parameters": {
        "jsCode": "// Merge parse result with original metadata\nconst parsed = $input.first().json;\nconst meta = $('Extract Metadata').first().json;\n\nreturn {\n  ...meta,\n  full_text: parsed.full_text || parsed.text || '',\n  page_count: parsed.page_count || parsed.pages?.length || 1,\n  pages: parsed.pages || [],\n  source_file: parsed.file_path || '',\n  ingest_id: meta.ingest_id,\n};"
      },
      "id": "ad3d319f-c9ed-4a3e-948b-2261ce8c5b82",
      "name": "Merge Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -32
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://ocr-container:8002/api/chunk",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "={{ $json.full_text }}"
            },
            {
              "name": "chunk_size",
              "value": "={{ 500 }}"
            },
            {
              "name": "chunk_overlap",
              "value": "={{ 50 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "35c83ac8-2791-4cc6-9c9e-59e0fe113784",
